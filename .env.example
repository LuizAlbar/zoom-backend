# Ambiente do servidor (dev, prod)
NODE_ENV=dev

# Porta em que o servidor backend irá rodar
PORT=8080

# Credenciais da Shopee Affiliate Open API (Obtenha no console de afiliados da Shopee)
SHOPEE_APP_ID=seu_shopee_app_id_aqui
SHOPEE_SECRET=seu_shopee_secret_aqui

# Endpoint GraphQL da Shopee Affiliate API
SHOPEE_GRAPHQL_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# Credenciais da API de Produtos do Magalu
MAGALU_ID=seu_magalu_id_aqui
MAGALU_SECRET=seu_magalu_secret_aqui
MAGALU_API_ENDPOINT=https://api.magalu.com
